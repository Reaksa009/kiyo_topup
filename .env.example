# Server Configuration. Server-only secrets must never use a VITE_ prefix.
# Warning: every VITE_ variable is included in the browser bundle. Do not put secrets there.
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3000/admin
CORS_ORIGINS=http://localhost:3000
# Must match the Vercel target. Preview must use a separate preview/staging database.
DEPLOYMENT_ENVIRONMENT=development
MONGODB_DATABASE_NAME=kiyo_topup

# Optional external Socket.IO service. Leave blank on Vercel to use API polling.
VITE_SOCKET_URL=

# Database & Cache
MONGODB_URI=replace-with-your-mongodb-connection-string
REDIS_URI=replace-with-your-redis-connection-string
ALLOW_IN_MEMORY_DB=true
AUTO_SEED_DATABASE=true
ENABLE_PAYMENT_SIMULATOR=true

# JWT Security
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_REFRESH_EXPIRES_IN=30d

# ABA PayWay Integration
# Payment credentials are server-only. Obtain values from the payment provider.
ABA_PAYWAY_MERCHANT_ID=
ABA_PAYWAY_API_KEY=
ABA_PAYWAY_API_URL=
ABA_PAYWAY_PUBLIC_KEY=

# Bakong KHQR Integration
BAKONG_MERCHANT_NAME=
BAKONG_MERCHANT_CITY=
BAKONG_MERCHANT_ID=
BAKONG_ACCOUNT_ID=
BAKONG_API_TOKEN=
BAKONG_API_URL=

# KHQR provider (recommended production integration)
KHQR_PROVIDER=khqr_link
KHQR_API_BASE_URL=https://api.khqr.link
KHQR_API_TOKEN=
KHQR_BAKONG_ACCOUNT_ID=
KHQR_ACCOUNT_NAME=KIYO TOPUP
KHQR_MERCHANT_CITY=PHNOM PENH
KHQR_CURRENCY=USD

# G2Bulk Automated Provider Integration
# G2Bulk credentials are server-only. Obtain endpoint details from official documentation.
G2BULK_API_URL=
G2BULK_API_KEY=
G2BULK_API_SECRET=
G2BULK_USER_ID=
MINIMUM_PROFIT_MINOR=0
# 500 basis points = 5%. Used only when a verified provider cost is available.
MAX_PROVIDER_PRICE_CHANGE_BPS=500
BAKONG_WEBHOOK_SECRET=replace-with-a-long-random-secret
G2BULK_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Telegram Bot Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Initial Super Admin Seed Credentials
SEED_ADMIN_EMAIL=admin@example.invalid
SEED_ADMIN_PASSWORD=replace-before-running-seed
