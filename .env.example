# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3000/admin
CORS_ORIGINS=http://localhost:3000

# Database & Cache
MONGODB_URI=mongodb://localhost:27017/kiyo_topup
REDIS_URI=redis://localhost:6379
ALLOW_IN_MEMORY_DB=true
AUTO_SEED_DATABASE=true
ENABLE_PAYMENT_SIMULATOR=true

# JWT Security
JWT_SECRET=super_secret_jwt_key_kiyo_topup_2026_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_kiyo_topup_2026
JWT_REFRESH_EXPIRES_IN=30d

# ABA PayWay Integration
ABA_PAYWAY_MERCHANT_ID=kiyo_merchant_001
ABA_PAYWAY_API_KEY=aba_payway_api_key_sample
ABA_PAYWAY_API_URL=https://checkout-sandbox.payway.com.kh/api/payment-gateway/v1/payments/purchase
ABA_PAYWAY_PUBLIC_KEY=aba_public_key_sample

# Bakong KHQR Integration
BAKONG_MERCHANT_NAME=KIYO TOPUP STORE
BAKONG_MERCHANT_CITY=Phnom Penh
BAKONG_MERCHANT_ID=kiyo_bakong_merchant_01
BAKONG_ACCOUNT_ID=kiyo@acleda
BAKONG_API_TOKEN=bakong_api_token_sample
BAKONG_API_URL=https://api-bakong.nbc.gov.kh/v1/check_transaction_by_md5

# G2Bulk Automated Provider Integration
G2BULK_API_URL=https://api.g2bulk.com/v1
