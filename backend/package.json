{
  "name": "kiyo-topup-backend",
  "version": "1.0.0",
  "description": "Express.js + TypeScript + MongoDB + Redis Backend for KIYO TOPUP Platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "tsx src/seed.ts",
    "sync-catalog": "tsx src/scripts/syncG2BulkCatalog.ts",
    "backfill-provider-catalogue": "tsx src/scripts/backfillProviderCatalogue.ts",
    "migrate-settings-credentials": "tsx src/scripts/migrateSettingsCredentialsToEnvironment.ts",
    "sanitize-provider-logs": "tsx src/scripts/sanitizeHistoricProviderLogs.ts",
    "verify-production-indexes": "tsx src/scripts/verifyProductionIndexes.ts",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.3",
    "morgan": "^1.10.0",
    "socket.io": "^4.8.1",
    "winston": "^3.17.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
